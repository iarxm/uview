#!/usr/bin/env bash

# iarom mail@iarom.org

# file preview via tabbed xembed with persistent preview file state
# files are sent to previewer via interface/server method
# dep: tabbed mpv neovim bookokrat tdf zathura prg_nuk bash
# tabbed configured w relative tabs and new pos = 1

_prn()         { printf "%s \n" "${@}"; }
_prn_deb()     { printf "%s\n" "${1}" >&2; }
_mim_set()     { mim_cur=$(file -bL --mime-type "${fil_cur}"); }

_cfg_ins()
{
    cfg_hmx="${XDG_CONFIG_HOME:-"${HOME}/.config"}"
    cfg_dir="${cfg_hmx}/uview"
    fil_cfg="${cfg_dir}/config"
    prg_src="${BASH_SOURCE[0]}"
    case "${prg_src}" in
        /*|*/*) ;;
        *) prg_src="$(command -v "${prg_src}")" || return 1 ;;
    esac
    prg_dir="$(CDPATH= cd -- "$(dirname -- "${prg_src}")" && pwd)" || return 1
    fil_def="${UVIEW_CONFIG_DEFAULT:-"${prg_dir}/../share/uview/config"}"
    [ -r "${fil_def}" ] || fil_def="${prg_dir}/config"
    [ -r "${fil_def}" ] || {
        _prn "default config not found (${fil_def})" >&2; return 1; }

    [ "${1}" = "--force" ] || [ ! -e "${fil_cfg}" ] || {
        _prn "config exists (${fil_cfg}); use --install-config --force to replace it" >&2
        return 1
    }
    install -d -m 755 "${cfg_dir}" && \
        install -m 644 "${fil_def}" "${fil_cfg}" || return
    _prn "installed ${fil_cfg}"
}

case "${1}" in
    --install-config)
        _cfg_ins "${2}"
        exit ;;
    --help|-h)
        _prn "usage: uview [--zen-mode] [FIFO [FILE]]"
        _prn "       uview --install-config [--force]"
        exit ;;
esac

uview_zen_cli="n"
[ "${1}" = "--zen-mode" ] && { uview_zen_cli="y"; shift; }
bok_zen="${uview_zen_cli}"
fif_x="${1}"
fil_cur="${2}"


_tab_chg()
{
    [ -n "${1}" ] || return 1
    xprop -id "${xid_tbd}" -f _TABBED_SELECT_TAB 8s \
        -set _TABBED_SELECT_TAB "0x$(printf '%x' "${1}")" || return
    xdotool windowactivate "${xid_fmx}"
}

_tab_chg_key()
{
    xdotool key --window "${xid_tbd}" "Ctrl+${1}"
    xdotool windowactivate "${xid_fmx}"
}

_tab_win_get()
{
    while [ "${c}" -le "5" ] ; do
        sleep "${tim_lim}"; c=$((c+1))
        xid_prg="$(xdotool search --pid "${1}" 2>/dev/null | head -n 1)"
        [ -n "${xid_prg}" ] && \
            [ "$(xwininfo -id "${xid_prg}" -tree 2>/dev/null \
                | awk '/Parent window id:/ { print $4 }')" = "${xid_tbd}" ] && {
                printf '%s' "${xid_prg}"; return; }
    done
}

_win_beh_fmx()
{
    timeout "2" \
        xdotool behave "${xid_tbd}" focus windowactivate "$xid_fmx"
}


# mpv

_mpv_ini()
{
    ${mpv} --input-ipc-server="${soc_mpv}" --wid="${xid_tbd}" \
        --focus-on=never --force-window=immediate --idle "${fil_cur}" &
    pid_mpv=$!
}

_mpv_add()
{
    printf '%s\n' \
        "{ \"command\": [\"loadfile\", \"${1:-"${fil_cur}"}\", \"replace\" ] }" \
        | socat - "${soc_mpv}" &> /dev/null
}

_mpv() { _mpv_add ;}


# pdf

_pdf_rnd()
{
    pdf_mtim="$(stat -Lc '%Y' "${fil_cur}")" || return
    pdf_sum="$(printf '%s\0' "${fil_cur}" | sha256sum | awk '{ print $1 }')"
    fil_pdf="${dir_pdf}/${pdf_sum}-${pdf_mtim}-${pdf_pag}-${pdf_dpi}.png"
    [ -r "${fil_pdf}" ] && return

    dir_tmp="$(mktemp -d "${dir_pdf}/.render.XXXXXX")" || return
    pdftocairo -f "${pdf_pag}" -l "${pdf_pag}" -singlefile -png \
        -r "${pdf_dpi}" "${fil_cur}" "${dir_tmp}/page" \
        && mv "${dir_tmp}/page.png" "${fil_pdf}" || {
            /bin/rm -rf "${dir_tmp}"; return 1; }
    /bin/rm -rf "${dir_tmp}"
}

_pdf() { _pdf_rnd && _mpv_add "${fil_pdf}"; }

# nvim

_nvi_ini()
{
    st -c preview-nvim -w "${xid_tbd}" -e \
        nvim --listen "${soc_nvi}" -c \
            'set shortmess+=I | hi CursorLine guibg=black guifg=black' &
    pid_trm=$!
}

_nvi_snd()
{
    case ${mim_cur} in
        text/*|text/x-diff|application/mbox) ncmd=":view ${fil_cur}<CR>" ;;
        inode/directory)  ncmd=":view ${fil_cur}/<CR>" ;; 
    esac
    nvim --server "${soc_nvi}" --remote-send "${ncmd}" &
}

_nvi()
{
  pid_nvi="$(pgrep -f "nvim --listen ${soc_nvi}")"
  { [ -n "${pid_nvi}" ] && _nvi_snd; } \
    || { _nvi_ini; _nvi_snd; }
}



# zat

_zat_snd()
{
    dbus-send --session --dest="${soc_zat}" --type=method_call \
        --print-reply \
            /org/pwmt/zathura org.pwmt.zathura.OpenDocument \
            string:"${fil_cur}" \
            string:'' \
            int32:1 &2>> /dev/null &
}

_zat_x() { zathura -e "${xid_tbd}" "$1" & pid_zat=$!; }


_zat_ini()
{
    _win_beh_fmx &
    [ ${mim_cur} = "application/pdf" ] || _zat_x "${fil_zat_ini}"
    _zat_x "${fil_cur}"
    c="1"; xid_zat="$(_tab_win_get "${pid_zat}")"
    soc_zat="org.pwmt.zathura.PID-${pid_zat}"
}

_zat()
{
    [ -e "/proc/${pid_zat}" ] && _zat_snd && return
    _zat_ini
}


# bookokrat

_bok_kil()
{
    [ -n "${pid_bok}" ] && kill "${pid_bok}" 2> /dev/null
    [ -n "${fif_bok}" ] && rm -f "${fif_bok}"
    pid_bok=""
    xid_bok=""
}

_bok_run_kil()
{
    [ -n "${pid_bok_run}" ] && kill "${pid_bok_run}" 2> /dev/null
    [ -n "${pid_bok_ctl}" ] && kill "${pid_bok_ctl}" 2> /dev/null
    [ -n "${fil_bok_nxt}" ] && rm -f "${fil_bok_nxt}"
    exit
}

_bok_run()
{
    fif_bok="${1}"
    bookokrat="${2}"
    fil_bok="${3}"
    bok_zen="${4:-"n"}"
    : ${tim_lim:="0.05"}
    trap _bok_run_kil SIGHUP SIGINT SIGTERM

    while : ; do
        # Background jobs otherwise receive /dev/null as standard input.
        if [ "${bok_zen}" = "y" ] ; then
            "${bookokrat}" --zen-mode "${fil_bok}" < /dev/tty &
        else
            "${bookokrat}" "${fil_bok}" < /dev/tty &
        fi
        pid_bok_run=$!
        fil_bok_nxt="$(mktemp)" || exit 1
        { IFS= read -r fil_nxt < "${fif_bok}"
            printf '%s\n' "${fil_nxt}" > "${fil_bok_nxt}"; } &
        pid_bok_ctl=$!

        while [ -e "/proc/${pid_bok_run}" ] && [ ! -s "${fil_bok_nxt}" ] ; do
            sleep "${tim_lim}"
        done

        if [ -s "${fil_bok_nxt}" ] ; then
            kill "${pid_bok_run}" 2> /dev/null
            wait "${pid_bok_run}" 2> /dev/null
            fil_bok="$(< "${fil_bok_nxt}")"
        else
            kill "${pid_bok_ctl}" 2> /dev/null
            wait "${pid_bok_ctl}" 2> /dev/null
            IFS= read -r fil_bok < "${fif_bok}" || {
                rm -f "${fil_bok_nxt}"; break; }
        fi

        wait "${pid_bok_ctl}" 2> /dev/null
        rm -f "${fil_bok_nxt}"
    done
}

_bok_ini()
{
    _win_beh_fmx &
    mkfifo "${fif_bok:="$(mktemp -u)"}"
    st -c preview-bookokrat -w "${xid_tbd}" -e \
        "${0}" --bookokrat-run "${fif_bok}" "${bookokrat}" "${fil_cur}" "${bok_zen}" &
    pid_bok=$!
    fil_bok="${fil_cur}"
    c="1"; xid_bok="$(_tab_win_get "${pid_bok}")"
}

_bok_add()
{
    printf '%s\n' "${fil_cur}" > "${fif_bok}"
    fil_bok="${fil_cur}"
}

_bok()
{
    [ "${fil_cur}" = "${fil_bok}" ] && \
        [ -n "${pid_bok}" ] && [ -e "/proc/${pid_bok}" ] && return
    [ -n "${pid_bok}" ] && [ -e "/proc/${pid_bok}" ] \
        && { _bok_add; return; }
    _bok_ini
}


# tdf

_tdf_kil()
{
    [ -n "${pid_tdf}" ] && kill "${pid_tdf}" 2> /dev/null
    [ -n "${fif_tdf}" ] && rm -f "${fif_tdf}"
    pid_tdf=""
    xid_tdf=""
}

_tdf_ini()
{
    _win_beh_fmx &
    mkfifo "${fif_tdf:="$(mktemp -u)"}"
    st -c preview-tdf -w "${xid_tbd}" -e \
        "${0}" --document-run "${fif_tdf}" "${tdf}" "${fil_cur}" &
    pid_tdf=$!
    fil_tdf="${fil_cur}"
    c="1"; xid_tdf="$(_tab_win_get "${pid_tdf}")"
}

_tdf_add()
{
    printf '%s\n' "${fil_cur}" > "${fif_tdf}"
    fil_tdf="${fil_cur}"
}

_tdf()
{
    [ "${fil_cur}" = "${fil_tdf}" ] && \
        [ -n "${pid_tdf}" ] && [ -e "/proc/${pid_tdf}" ] && return
    [ -n "${pid_tdf}" ] && [ -e "/proc/${pid_tdf}" ] \
        && { _tdf_add; return; }
    _tdf_ini
}


# tabbed

_prg_tbd_ini ()
{
    xid_fmx="$(xdotool getactivewindow)"
    mkfifo "${fif_y:="$(mktemp -u)"}"
    tabbed -n preview > "${fif_y}" &
    
    jobs
    pid_tbd="$(jobs -p %%)"
    [ -z "${pid_tbd}" ] && exit 1
    
    soc_xxx="$(echo ${fif_x} | grep -o '[0-9]\+')"
    soc_mpv="/tmp/uview${soc_xxx}.tbd-${pid_tbd}.mpv.soc"
    soc_nvi="/tmp/uview${soc_xxx}.tbd-${pid_tbd}.nvi.soc"
    
    read -r xid_tbd < "${fif_y}" && rm "${fif_y}"
    
    _win_beh_fmx &
    _mpv_ini

    c="1"; xid_mpv="$(_tab_win_get "${pid_mpv}")"
    _nvi_ini
    c="1"; xid_nvi="$(_tab_win_get "${pid_trm}")"
    [ "${pdf_prv}" = "image" ] || _zat_ini

    # Neovim is started last, so restore the initial media preview afterwards.
    case "${mim_cur}" in
        video/*|image/*|audio/*) _tab_swi ;;
    esac
}


_ini()
{
    declare -g mim_cur
    declare -g xid_tbd
    declare -g pid_tbd
    declare -g soc_mpv
    declare -g soc_nvi
    declare -g soc_zat
    declare -g pid_mpv
    declare -g pid_trm
    declare -g xid_mpv
    declare -g xid_nvi
    declare -g xid_zat
    declare -g pid_bok
    declare -g fil_bok
    declare -g xid_bok
    declare -g fif_bok
    declare -g pid_tdf
    declare -g fil_tdf
    declare -g xid_tdf
    declare -g fif_tdf
    
    declare -g tim_swi="y"
      
    declare -gi c="1"
    declare -gi tab_mpv="1"
    declare -gi tab_nvi="2"
    declare -gi tab_zat="3"
    declare -g  mim_las # last preview prg to load
      
    declare -g  cfg_hmx="${XDG_CONFIG_HOME:-"${HOME}/.config"}"
      
    : ${cfg_dir:="${cfg_hmx}/uview"} && \
        [ -d "${cfg_dir}" ] || mkdir "${cfg_dir}"
      
    source "${cfg_dir}/config" 2>/dev/null
    [ "${uview_zen_cli}" = "y" ] && bok_zen="y"
    
    : ${tim_lim:="0.05"}
    : ${tim_lim_y:="200"}
    : ${doc_prv:="bookokrat"}
    : ${pdf_prv:="image"}
    : ${pdf_pag:="1"}
    : ${pdf_dpi:="100"}
    : ${fil_cur:="${nnn}"}
    : ${fif_x:="${NNN_FIFO}"}
      
    [ ! -r "${fif_x}" ] && { echo "fif read fail (${fif_x})" 1>&2 ; exit 1; }
      
    #mkfifo "${fif_zer:=$(mktemp -u)}"
      
    _mim_set
    
    declare -g fil_zat_ini="${HOME}/.cache/blank.pdf"
    declare -g dir_pdf="${XDG_CACHE_HOME:-"${HOME}/.cache"}/uview/pdf"
    [ "${pdf_prv}" != "image" ] || mkdir -p "${dir_pdf}"
    
    declare -g prg_nk2="${cfg_hmx}/nnn/plugins/nuke"
    
    : ${prg_nuk:="${prg_nk1:-"${prg_nk2}"}"}
    : ${prg_pgr:="nvim -R"}
    : ${prg_trm:="st -c preview -w"}
    : ${mpv:="${MPVX:="mpv"}"}
    : ${bookokrat:="bookokrat"}
    : ${tdf:="tdf"}
     
    if which ${prg_trm} >/dev/null 2>&1 ; then :
    elif which st       >/dev/null 2>&1 ; then prg_trm="st -c preview -w"
    elif which urxvt    >/dev/null 2>&1 ; then prg_trm="urxvt -embed"
    elif which xterm    >/dev/null 2>&1 ; then prg_trm="xterm -into"
    else _prn "no xembed term found" >&2 ; fi
  
    if which mpv     >/dev/null 2>&1 ; then
        media() { _mpv; } else
        media() { _trm_nuk; } fi
    if [ "${doc_prv}" = "bookokrat" ] && which ${bookokrat} >/dev/null 2>&1 ; then
        doc()   { _bok; }
    elif [ "${doc_prv}" = "tdf" ] && which ${tdf} >/dev/null 2>&1 ; then
        doc()   { case "${mim_cur}" in
            application/pdf) _tdf ;;
            *) which ${bookokrat} >/dev/null 2>&1 && _bok || _trm_nuk ;;
        esac; }
    elif [ "${pdf_prv}" = "image" ] && which pdftocairo >/dev/null 2>&1 ; then
        doc()   { _pdf; }
    elif which zathura >/dev/null 2>&1 ; then
        doc()   { _zat; }; else
        doc()   { _trm_nuk; }; fi
    if which nvim    >/dev/null 2>&1 ; then
        txtp()  { _nvi; }
        inodev(){ _nvi; }; else
        txtp()  { _trm_nuk; }; fi 

    exec >/dev/null 2>&1  # mute from now
    #exec >uview.log 2>&1 # debug mode

    trap _kil SIGINT
}


# mime handling

_tab_swi()
{
    [ ${mim_cur} = ${mim_las} ] || \
        case ${mim_cur} in
            video/*|image/*|audio/*) [ -n "${xid_mpv}" ] || {
                c="1"; xid_mpv="$(_tab_win_get "${pid_mpv}")"; }
                _tab_chg "${xid_mpv}" \
                || _tab_chg_key "${tab_mpv}" ;;
            text/*|text/x-diff|application/mbox|inode/*) [ -n "${xid_nvi}" ] || {
                c="1"; xid_nvi="$(_tab_win_get "${pid_trm}")"; }
                _tab_chg "${xid_nvi}" \
                || _tab_chg_key "${tab_nvi}" ;;
            application/pdf)         case ${doc_prv} in
                bookokrat) [ -n "${xid_bok}" ] || {
                    c="1"; xid_bok="$(_tab_win_get "${pid_bok}")"; }
                    _tab_chg "${xid_bok}" \
                    || xdotool key --window "${xid_tbd}" "Ctrl+${tab_zat}" ;;
                tdf) [ -n "${xid_tdf}" ] || {
                    c="1"; xid_tdf="$(_tab_win_get "${pid_tdf}")"; }
                    _tab_chg "${xid_tdf}" \
                    || xdotool key --window "${xid_tbd}" "Ctrl+${tab_zat}" ;;
                *)     case ${pdf_prv} in
                image) [ -n "${xid_mpv}" ] || {
                    c="1"; xid_mpv="$(_tab_win_get "${pid_mpv}")"; }
                    _tab_chg "${xid_mpv}" \
                    || xdotool key --window "${xid_tbd}" "Ctrl+${tab_mpv}" ;;
                *)     [ -n "${xid_zat}" ] || {
                    c="1"; xid_zat="$(_tab_win_get "${pid_zat}")"; }
                    _tab_chg "${xid_zat}" \
                    || xdotool key --window "${xid_tbd}" "Ctrl+${tab_zat}" ;;
                esac ;; esac ;;
            application/epub+zip|application/x-djvu|image/vnd.djvu) \
                                   [ -n "${xid_bok}" ] || {
                                       c="1"; xid_bok="$(_tab_win_get "${pid_bok}")"; }
                                   _tab_chg "${xid_bok}" \
                                   || xdotool key --window "${xid_tbd}" "Ctrl+${tab_zat}" ;;
        esac
}


_mim_swi()
{
    [ n = ${tim_swi} ] || \
        case "${mim_cur}" in
            video/*)                  media ;;
            application/octet-stream) media ;;
            audio/*)                  media ;;
            image/*)                  media ;;
            application/pdf)          doc ;;
            application/epub+zip)     doc ;;
            application/x-djvu)       doc ;;
            image/vnd.djvu)           doc ;;
            inode/directory)          inodev ;;
            text/*|text/x-diff|application/mbox) txtp ;;
        esac
} #*) all ;; 

_kil()
{ 
    kill "${pid_tbd}"
    _bok_kil
    _tdf_kil
    rm -f "${soc_mpv}" "${soc_nvi}"
    exec 3>&-
    disown
    exit 0
}

_main()
{
    _ini
    _prg_tbd_ini

    while read -r fil_cur ; do
        
        timeout 0.01 cat < "${fif_x}"
        #timeout 0.01 cat < "${fif_x}" tail -n 1 | >&3
      
        jobs; jobs | grep tabbed || break
        [ ! -e "${fil_cur}" ] && continue
         
        _mim_set
        _tab_swi
        _mim_swi
        
        mim_las="${mim_cur}"

    done < "${fif_x}"

    _kil
}

case "${1}" in
    --bookokrat-run|--document-run)
        _bok_run "${2}" "${3}" "${4}" "${5}"
        exit ;;
esac

_main &
